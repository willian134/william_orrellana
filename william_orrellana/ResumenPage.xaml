<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="william_orrellana.ResumenPage"
             Title="Resumen">

    <ScrollView BackgroundColor="#0F172A">
        <VerticalStackLayout Padding="25" Spacing="15" MaximumWidthRequest="500">
            <Label x:Name="lblTopUsuario" TextColor="#94A3B8" HorizontalOptions="End" FontSize="13"/>

            <Label Text="RESUMEN GENERAL" FontSize="20" FontAttributes="Bold" TextColor="#00B0FF" HorizontalOptions="Center"/>

            <Border BackgroundColor="#1E293B" Stroke="#334155" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*,*" RowSpacing="12">
                    <Label Grid.Row="0" Grid.Column="0" Text="Nombre:" TextColor="#94A3B8"/>
                    <Label Grid.Row="0" Grid.Column="1" x:Name="lblNombre" TextColor="#FFFFFF" FontAttributes="Bold"/>

                    <Label Grid.Row="1" Grid.Column="0" Text="Apellido:" TextColor="#94A3B8"/>
                    <Label Grid.Row="1" Grid.Column="1" x:Name="lblApellido" TextColor="#FFFFFF" FontAttributes="Bold"/>

                    <Label Grid.Row="2" Grid.Column="0" Text="Edad:" TextColor="#94A3B8"/>
                    <Label Grid.Row="2" Grid.Column="1" x:Name="lblEdad" TextColor="#FFFFFF"/>

                    <Label Grid.Row="3" Grid.Column="0" Text="Fecha:" TextColor="#94A3B8"/>
                    <Label Grid.Row="3" Grid.Column="1" x:Name="lblFecha" TextColor="#FFFFFF"/>

                    <Label Grid.Row="4" Grid.Column="0" Text="Ciudad:" TextColor="#94A3B8"/>
                    <Label Grid.Row="4" Grid.Column="1" x:Name="lblCiudad" TextColor="#FFFFFF"/>

                    <Label Grid.Row="5" Grid.Column="0" Text="País:" TextColor="#94A3B8"/>
                    <Label Grid.Row="5" Grid.Column="1" x:Name="lblPais" TextColor="#FFFFFF"/>

                    <Label Grid.Row="6" Grid.Column="0" Text="Monto Inicial:" TextColor="#94A3B8"/>
                    <Label Grid.Row="6" Grid.Column="1" x:Name="lblMonto" TextColor="#FFFFFF"/>

                    <Label Grid.Row="7" Grid.Column="0" Text="Pago Mensual:" TextColor="#94A3B8"/>
                    <Label Grid.Row="7" Grid.Column="1" x:Name="lblMensual" TextColor="#00E676" FontAttributes="Bold"/>

                    <Label Grid.Row="8" Grid.Column="0" Text="Total a Pagar:" TextColor="#94A3B8"/>
                    <Label Grid.Row="8" Grid.Column="1" x:Name="lblTotal" TextColor="#00B0FF" FontAttributes="Bold"/>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>